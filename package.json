{
  "name": "ai-field-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "gen": "node scripts/gen-pages.mjs && node scripts/copy-pyodide.mjs",
    "dev": "npm run gen && vite",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "shots": "node tests/screenshots.mjs",
    "check:wording": "node scripts/check-wording.mjs",
    "test:digits": "node tests/digits-check.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "katex": "^0.16.11",
    "pyodide": "^314.0.7",
    "three": "^0.180.0"
  }
}
